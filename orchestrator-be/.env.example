SERVER_HOST=127.0.0.1
SERVER_PORT=3000
LOG_LEVEL=info

# Auth TTLs (milliseconds)
AUTH_CHALLENGE_TTL_MS=120000
AUTH_SESSION_TTL_MS=1800000

# ASM RPC endpoint for role membership checks
STRATA_ADMIN_STATE_RPC_URL=http://127.0.0.1:8080

# Bitcoin RPC — used by GET /ready only (broadcast executes in the desktop app)
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASS=rpcpass
BITCOIN_WALLET_NAME=testwallet

# Optional: production profile requires durable storage
# ORCHESTRATOR_PROFILE=production
# DATABASE_URL=postgres://user:pass@localhost/alpen_multisig
