# syntax=docker/dockerfile:1
#
# Dev-only image: regtest-dev-api (mine + faucet endpoints).
# Connects to the bitcoin service on the Docker network.
#
# NOT for production use.

# ── Stage 1: Build ───────────────────────────────────────────────────────────
FROM rust:slim-bookworm AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
    git pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY rust-toolchain.toml ./
RUN rustup show

COPY Cargo.toml Cargo.lock ./
COPY orchestrator-be/Cargo.toml orchestrator-be/
COPY desktop-app/src-tauri/Cargo.toml desktop-app/src-tauri/
COPY e2e-tests/Cargo.toml e2e-tests/
COPY regtest-dev-api/Cargo.toml regtest-dev-api/

RUN mkdir -p orchestrator-be/src \
    && echo 'fn main(){}' > orchestrator-be/src/main.rs \
    && mkdir -p desktop-app/src-tauri/src \
    && echo 'fn main(){}' > desktop-app/src-tauri/src/main.rs \
    && mkdir -p e2e-tests/src \
    && touch e2e-tests/src/lib.rs \
    && mkdir -p regtest-dev-api/src \
    && echo 'fn main(){}' > regtest-dev-api/src/main.rs

RUN cargo fetch

COPY regtest-dev-api/src regtest-dev-api/src/

RUN cargo build --release -p regtest-dev-api

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /build/target/release/regtest-dev-api /usr/local/bin/regtest-dev-api

RUN chmod +x /usr/local/bin/regtest-dev-api

EXPOSE 3001

CMD ["/usr/local/bin/regtest-dev-api"]
