# Orchestrator HTTP API (optional — default matches local stack)
# VITE_ORCHESTRATOR_BASE_URL=http://127.0.0.1:3000/api/v1

# Broadcast: loaded by Tauri at startup from this file (desktop-app/.env). Not exposed to the webview.
# Mirror orchestrator-be/.env for local dev. Copy to desktop-app/.env — do not use src-tauri/.env.
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASS=rpcpass
BITCOIN_WALLET_NAME=testwallet
BITCOIN_NETWORK=regtest
BITCOIN_MAGIC_BYTES_HEX=414c504e

# Commit funding mode (dev/regtest):
# - unset / bitcoind (default): fund commit via the node wallet `sendtoaddress` (uses BITCOIN_WALLET_NAME)
# - admin_wallet: fund commit from the Admin Wallet (BDK) — requires regtest and ADMIN_WALLET_REGTEST_MNEMONIC
# COMMIT_FUNDING=admin_wallet
#
# Dev-only mnemonic for Admin Wallet funding (regtest only). Do NOT use in production.
# ADMIN_WALLET_REGTEST_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
STRATA_ADMIN_STATE_RPC_URL=http://127.0.0.1:8080
# Dev-only mnemonic for the Admin Wallet seed (regtest only). Also the source of the SPS-50
# commit/reveal internal key at m/86'/0'/73'/2/0 (Phase 3.5+). Do NOT use in production.
ADMIN_WALLET_REGTEST_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
# Required to enable mnemonic-derived signing (regtest only). Guards both Admin Wallet
# funding (COMMIT_FUNDING=admin_wallet) and the commit/reveal internal key derivation.
ALLOW_DEV_MNEMONIC_SIGNING=1
