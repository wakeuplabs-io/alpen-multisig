# Orchestrator HTTP API (optional — default matches local stack)
# VITE_ORCHESTRATOR_BASE_URL=http://127.0.0.1:3000/api/v1

# Broadcast: loaded by Tauri at startup from this file (desktop-app/.env). Not exposed to the webview.
# Mirror orchestrator-be/.env for local dev. Copy to desktop-app/.env — do not use src-tauri/.env.
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASS=rpcpass
BITCOIN_NETWORK=regtest
BITCOIN_MAGIC_BYTES_HEX=414c504e

# Dev-only mnemonic (regtest only). Do NOT use in production.
#
# Phase 3.7 (3.7b): wallet panel, commit funding, and SPS-50 commit/reveal internal key
# (m/86'/0'/73'/2/0) derive from the login session (Palabras) when logged in. This env var is
# CI/headless fallback only when no session is active (integration tests, E2E without UI login).
# An active session always wins. Required in .env for headless broadcast/wallet IPC until Phase 9.
ADMIN_WALLET_REGTEST_MNEMONIC="abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon abandon about"
# Required to enable mnemonic-derived signing (regtest only). Guards Admin Wallet
# commit funding and commit/reveal internal key derivation.
ALLOW_DEV_MNEMONIC_SIGNING=1
STRATA_ADMIN_STATE_RPC_URL=http://127.0.0.1:8080
