# Orchestrator HTTP API (optional — default matches local stack)
VITE_ORCHESTRATOR_BASE_URL=http://127.0.0.1:3000/api/v1

# Broadcast: loaded by Tauri at startup from this file (desktop-app/.env). Not exposed to the webview.
# RPC endpoints (Bitcoin + Strata) are configured at runtime via Node Config (Settings > Node).
BITCOIN_NETWORK=regtest
BITCOIN_MAGIC_BYTES_HEX=414c504e

# Admin Wallet sync (R2.3): the Electrum indexer URL is configured at runtime via Node Config
# (Settings > Node) — Local defaults to the electrs from scripts/local-stack.sh
# (tcp://127.0.0.1:60401); Custom accepts tcp:// or ssl:// URLs. No env var is read.
# Broadcast and fee estimation stay on Bitcoin Core RPC.

# Signing capability is decided per-signer by network (R1.1): the mnemonic ("Palabras")
# signer is allowed on regtest/testnet only; a hardware wallet is allowed on any network.
# No env flag gates broadcast anymore. The Admin Wallet mnemonic comes from the login
# session via wallet_session_init — never from env.
# multiply toss magic exclude crawl obey garden black apart room village neglect
