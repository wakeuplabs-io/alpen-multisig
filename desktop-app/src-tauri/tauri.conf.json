{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Strata Multisig",
	"version": "0.2.3",
	"identifier": "com.strata.multisig",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Strata Multisig",
				"width": 900,
				"height": 700,
				"resizable": true
			}
		],
		"security": {
			"csp": "default-src 'self' blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://localhost:* http://127.0.0.1:* https:; img-src 'self' data: blob:; font-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
