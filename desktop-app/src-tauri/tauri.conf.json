{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Alpen Multisig Hello",
	"version": "0.1.0",
	"identifier": "com.alpen.multisig.hello",
	"build": {
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Alpen Multisig Hello",
				"width": 900,
				"height": 700,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all"
	}
}
