{
	"type": "workspace_readwrite",
	"additionalReadwritePaths": [],
	"additionalReadonlyPaths": [],
	"enableSharedBuildCache": true,
	"networkPolicy": {
		"default": "deny",
		"allow": [
			"registry.npmjs.org",
			"registry.yarnpkg.com",
			"pypi.org",
			"files.pythonhosted.org",
			"crates.io",
			"static.crates.io",
			"github.com",
			"*.github.com",
			"*.githubusercontent.com",
			"codeload.github.com",
			"uploads.github.com",
			"api.github.com",
			"ghcr.io",
			"*.docker.io",
			"gitlab.com",
			"*.gitlab.com"
		],
		"deny": []
	}
}
